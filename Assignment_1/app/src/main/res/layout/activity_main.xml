<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    >

    <com.google.android.material.imageview.ShapeableImageView
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:id="@+id/image"
        android:layout_marginTop="50dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:src="@drawable/image1"
        app:shapeAppearanceOverlay="@style/custom_1"
        />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/bitcode"
        style="@style/custom_1"
        android:text="@string/welcome_to_bitcode"
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@id/image"
        app:layout_constraintLeft_toLeftOf="parent"
        android:textAlignment="center"
        android:textColor="@color/red"
        />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/form"
        style="@style/custom_1"
        android:text="@string/enquiry_form"
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@id/bitcode"
        app:layout_constraintLeft_toLeftOf="parent"
        android:textAlignment="center"
        android:textColor="@color/blue"/>

    <TextView
        android:layout_width="80dp"
        android:layout_height="48dp"
        android:id="@+id/Name"
        style="@style/custom_1"
        android:text="@string/name"
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@id/form"
        app:layout_constraintLeft_toLeftOf="parent"
        />

    <EditText
        android:layout_width="280dp"
        android:layout_height="48dp"
        android:id="@+id/edtName"
        android:importantForAutofill="no"
        app:layout_constraintLeft_toRightOf="@id/Name"
        app:layout_constraintTop_toBottomOf="@id/form"
        style="@style/custom_1"
        android:hint="@string/enter_name"
        android:inputType="text"
        />

    <TextView
        android:layout_width="80dp"
        android:layout_height="48dp"
        android:id="@+id/phoneNo"
        style="@style/custom_1"
        android:text="@string/phone_no"
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@id/Name"
        app:layout_constraintLeft_toLeftOf="parent"
        />

    <EditText
        android:layout_width="280dp"
        android:layout_height="48dp"
        android:id="@+id/etdPhone"
        android:importantForAutofill="no"
        app:layout_constraintLeft_toRightOf="@id/Name"
        app:layout_constraintTop_toBottomOf="@id/edtName"
        style="@style/custom_1"
        android:hint="@string/phone_number"
        android:inputType="number"
        tools:ignore="TextFields" />

    <TextView
        android:layout_width="80dp"
        android:layout_height="48dp"
        android:id="@+id/Email"
        style="@style/custom_1"
        android:text="@string/email"
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@id/phoneNo"
        app:layout_constraintLeft_toLeftOf="parent"
        />

    <EditText
        android:id="@+id/etdEmail"
        style="@style/custom_1"
        android:layout_width="280dp"
        android:layout_height="48dp"
        android:layout_marginLeft="8dp"
        android:hint="@string/email"
        android:importantForAutofill="no"
        android:inputType="textEmailAddress"
        app:layout_constraintLeft_toRightOf="@id/Email"
        app:layout_constraintTop_toBottomOf="@id/etdPhone"
        tools:ignore="TextFields" />

    <TextView
        android:layout_width="80dp"
        android:layout_height="48dp"
        android:id="@+id/Address"
        style="@style/custom_1"
        android:text="@string/address"
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@id/Email"
        app:layout_constraintLeft_toLeftOf="parent"
        />

    <EditText
        android:layout_width="280dp"
        android:layout_height="48dp"
        android:id="@+id/edtAddress"
        android:importantForAutofill="no"
        app:layout_constraintLeft_toRightOf="@id/Address"
        app:layout_constraintTop_toBottomOf="@id/etdEmail"
        style="@style/custom_1"
        android:hint="@string/address"
        tools:ignore="TextFields" />

    <TextView
        android:layout_width="80dp"
        android:layout_height="48dp"
        android:id="@+id/collageCompany"
        style="@style/custom_1"
        android:text="@string/collage_company_name"
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@id/Address"
        app:layout_constraintLeft_toLeftOf="parent"
        />

    <EditText
        android:layout_width="280dp"
        android:layout_height="48dp"
        android:id="@+id/edtCollage"
        android:importantForAutofill="no"
        app:layout_constraintLeft_toRightOf="@id/collageCompany"
        app:layout_constraintTop_toBottomOf="@id/Address"
        style="@style/custom_1"
        android:hint="@string/collage_company_name"
        android:inputType="text"
        tools:ignore="TextFields" />

    <TextView
        android:layout_width="80dp"
        android:layout_height="48dp"
        android:id="@+id/techName"
        style="@style/custom_1"
        android:text="@string/techname"
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@id/collageCompany"
        app:layout_constraintLeft_toLeftOf="parent"
        />

    <EditText
        android:layout_width="280dp"
        android:layout_height="48dp"
        android:id="@+id/edtTech"
        android:importantForAutofill="no"
        app:layout_constraintLeft_toRightOf="@id/techName"
        app:layout_constraintTop_toBottomOf="@id/edtCollage"
        style="@style/custom_1"
        android:hint="@string/techname"
        android:inputType="text"
        tools:ignore="TextFields" />

    <TextView
        android:layout_width="80dp"
        android:layout_height="48dp"
        android:id="@+id/yearOfPassing"
        style="@style/custom_1"
        android:text="@string/year_of_passing"
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@id/techName"
        app:layout_constraintLeft_toLeftOf="parent"
        />

    <EditText
        android:layout_width="280dp"
        android:layout_height="48dp"
        android:id="@+id/edtYearOfPass"
        app:layout_constraintLeft_toRightOf="@id/yearOfPassing"
        app:layout_constraintTop_toBottomOf="@id/edtTech"
        style="@style/custom_1"
        android:hint="@string/year_of_passing"
        android:inputType="number"
        tools:ignore="Autofill,TextFields" />

    <Button
        android:layout_width="150dp"
        android:layout_height="50dp"
        android:id="@+id/btnSubmit"
        style="@style/custom_2"
        app:layout_constraintTop_toBottomOf="@id/edtYearOfPass"
        app:layout_constraintLeft_toLeftOf="parent"
        android:text="@string/submit"
        android:textSize="20sp"
        app:flow_horizontalAlign="center"
        />

</androidx.constraintlayout.widget.ConstraintLayout>