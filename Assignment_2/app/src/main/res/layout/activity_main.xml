<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:background="@drawable/background">

    <com.google.android.material.imageview.ShapeableImageView
        android:layout_width="280dp"
        android:layout_height="250dp"
        android:id="@+id/homeImage"
        android:layout_marginTop="80dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:src="@drawable/click"
        />

    <Button
        android:layout_width="130dp"
        android:layout_height="50dp"
        android:id="@+id/btnApple"
        style="@style/custom_1"
        android:text="@string/apple"
        app:layout_constraintTop_toBottomOf="@id/homeImage"
        app:layout_constraintLeft_toLeftOf="parent"
        />

    <Button
        android:layout_width="130dp"
        android:layout_height="50dp"
        android:id="@+id/btnSamSung"
        style="@style/custom_2"
        android:text="@string/samsung"
        app:layout_constraintTop_toBottomOf="@id/homeImage"
        app:layout_constraintRight_toRightOf="parent"
        />

    <Button
        android:layout_width="130dp"
        android:layout_height="50dp"
        android:id="@+id/btnVivo"
        style="@style/custom_1"
        android:text="@string/vivo"
        app:layout_constraintTop_toBottomOf="@id/btnApple"
        app:layout_constraintLeft_toLeftOf="parent"
        />

    <Button
        android:layout_width="130dp"
        android:layout_height="50dp"
        android:id="@+id/btnOppo"
        style="@style/custom_2"
        android:text="@string/oppo"
        app:layout_constraintTop_toBottomOf="@id/btnSamSung"
        app:layout_constraintRight_toRightOf="parent"
        />


</androidx.constraintlayout.widget.ConstraintLayout>