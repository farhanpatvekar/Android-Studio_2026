<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/black">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        android:id="@+id/logo2"
        android:src="@drawable/logo"
        android:layout_marginTop="55dp"
        />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/appname5"
        app:layout_constraintTop_toBottomOf="@id/logo2"
        app:layout_constraintLeft_toLeftOf="parent"
        android:text="        FitNexa"
        android:textColor="#B8FF1A"
        android:textStyle="italic"
        android:textSize="55sp"
        android:layout_marginTop="20dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/userdeatil"
        app:layout_constraintTop_toBottomOf="@id/appname5"
        app:layout_constraintLeft_toLeftOf="@id/appname5"
        android:text="           Enter Your Details!!!"
        android:textSize="30sp"
        android:textStyle="italic"
        android:textColor="@color/white"
        android:layout_marginRight="20dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="40dp"
        />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/name"
        app:layout_constraintTop_toBottomOf="@id/userdeatil"
        app:layout_constraintLeft_toLeftOf="parent"
        android:text="Name :"
        android:textColor="@color/white"
        android:textStyle="italic"
        android:textSize="25sp"
        android:layout_marginTop="53dp"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="310dp"
        />

    <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/name1"
        app:layout_constraintTop_toBottomOf="@+id/userdeatil"
        app:layout_constraintLeft_toRightOf="parent"
        android:layout_marginTop="40dp"
        android:layout_marginRight="15dp"
        android:layout_marginLeft="95dp"
        android:hint="Enter Name"
        android:textSize="25sp"
        android:textStyle="italic"
        android:textColor="#FFFFFF"
        android:textColorHint="#AAAAAA"
        />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/age"
        app:layout_constraintTop_toBottomOf="@id/name"
        app:layout_constraintLeft_toLeftOf="parent"
        android:text="Age :"
        android:textColor="@color/white"
        android:textStyle="italic"
        android:textSize="25sp"
        android:layout_marginTop="28dp"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="340dp"
        />

    <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/age1"
        app:layout_constraintTop_toBottomOf="@+id/name1"
        app:layout_constraintLeft_toRightOf="parent"
        android:layout_marginTop="10dp"
        android:layout_marginRight="15dp"
        android:layout_marginLeft="75dp"
        android:hint="Enter Age"
        android:textSize="25sp"
        android:textStyle="italic"
        android:textColor="#FFFFFF"
        android:textColorHint="#AAAAAA"
        />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/gender"
        app:layout_constraintTop_toBottomOf="@id/age"
        app:layout_constraintLeft_toLeftOf="parent"
        android:text="Gender :"
        android:textColor="@color/white"
        android:textStyle="italic"
        android:textSize="25sp"
        android:layout_marginTop="28dp"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="305dp"
        />

    <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/gender1"
        app:layout_constraintTop_toBottomOf="@+id/age1"
        app:layout_constraintLeft_toRightOf="parent"
        android:layout_marginTop="10dp"
        android:layout_marginRight="15dp"
        android:layout_marginLeft="108dp"
        android:hint="Enter Gender"
        android:textSize="25sp"
        android:textStyle="italic"
        android:textColor="#FFFFFF"
        android:textColorHint="#AAAAAA"
        />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/email"
        app:layout_constraintTop_toBottomOf="@id/gender"
        app:layout_constraintLeft_toLeftOf="parent"
        android:text="Email :"
        android:textColor="@color/white"
        android:textStyle="italic"
        android:textSize="25sp"
        android:layout_marginTop="28dp"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="315dp"
        />

    <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/email1"
        app:layout_constraintTop_toBottomOf="@+id/gender1"
        app:layout_constraintLeft_toRightOf="parent"
        android:layout_marginTop="5dp"
        android:layout_marginRight="15dp"
        android:layout_marginLeft="95dp"
        android:hint="Enter Email"
        android:textSize="25sp"
        android:textStyle="italic"
        android:textColor="#FFFFFF"
        android:textColorHint="#AAAAAA"
        />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/phone"
        app:layout_constraintTop_toBottomOf="@id/email"
        app:layout_constraintLeft_toLeftOf="parent"
        android:text="Phone :"
        android:textColor="@color/white"
        android:textStyle="italic"
        android:textSize="25sp"
        android:layout_marginTop="28dp"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="310dp"
        />

    <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/phone1"
        app:layout_constraintTop_toBottomOf="@+id/email1"
        app:layout_constraintLeft_toRightOf="parent"
        android:layout_marginTop="5dp"
        android:layout_marginRight="15dp"
        android:layout_marginLeft="98dp"
        android:hint="Enter Phone Number"
        android:textSize="25sp"
        android:textStyle="italic"
        android:textColor="#FFFFFF"
        android:textColorHint="#AAAAAA"
        />

    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/submit"
        app:layout_constraintTop_toBottomOf="@+id/phone"
        app:layout_constraintLeft_toLeftOf="parent"
        android:layout_marginTop="40dp"
        android:layout_marginLeft="100dp"
        android:layout_marginRight="100dp"
        android:text="Submit"
        android:textColor="@color/black"
        android:textStyle="italic"
        android:textSize="30sp"
        android:backgroundTint="#B8FF1A"
        />

</androidx.constraintlayout.widget.ConstraintLayout>